# Copy to .env and fill in. Root .env for the whole-system docker-compose.yml.
# Generate values with: openssl rand -hex 16

# Postgres superuser (only used by the init script, not by any service)
POSTGRES_PASSWORD=

# Per-service database users (database-per-service: each user owns only its DBs)
CORE_DB_PASSWORD=
ORDER_DB_PASSWORD=

# RabbitMQ (shared message broker between services)
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=
